# Setec Astronomy endpoint config (bring your own backend + key).
# Copy to .env and edit. The key stays in your environment and goes only to the
# endpoint you name. `.env` is gitignored; this example file is safe to commit.
#
# Read by scripts/llm.py:
#   SETEC_BASE_URL  base URL ('.../v1') or a full '.../chat/completions' URL
#   SETEC_API_KEY   your key (use any non-empty value for keyless local Ollama)
#   SETEC_MODEL     model id

# --- Fireworks (default in the docs) ---
SETEC_BASE_URL=https://api.fireworks.ai/inference/v1
SETEC_API_KEY=
SETEC_MODEL=accounts/fireworks/models/deepseek-v4-flash

# --- OpenAI ---
# SETEC_BASE_URL=https://api.openai.com/v1
# SETEC_API_KEY=sk-...
# SETEC_MODEL=gpt-4o-mini

# --- OpenRouter ---
# SETEC_BASE_URL=https://openrouter.ai/api/v1
# SETEC_API_KEY=sk-or-...
# SETEC_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Ollama (local, keyless) ---
# SETEC_BASE_URL=http://localhost:11434/v1
# SETEC_API_KEY=ollama
# SETEC_MODEL=llama3.1
